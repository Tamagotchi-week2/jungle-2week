# Postgres 연결 문자열 (Neon 등)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js 세션 서명 키. `npx auth secret` 으로 생성
AUTH_SECRET=""

# 개발·시연용. 1 이면 성장 요구치를 3 / 4 회로 낮춘다 (설계 문서 14장)
# 운영 배포 시에는 반드시 비워둘 것
GAME_FAST_MODE=""

# 통합 테스트용 DB. 설정하면 npm test 가 서비스 계층 통합 테스트까지 돌린다.
# 반드시 DATABASE_URL 과 다른 대상이어야 한다 — 테스트가 테이블을 비운다.
# 같은 Neon DB 안에서 스키마만 분리하는 것이 가장 간단하다.
#   TEST_DATABASE_URL="<DATABASE_URL 과 동일>&schema=test_integration"
# 최초 1회: DATABASE_URL="<위 값>" npx prisma migrate deploy
TEST_DATABASE_URL=""
